{
  "name": "@coldsmirk/commitlint-config",
  "version": "0.6.0",
  "description": "Opinionated commitlint config: Conventional Commits, enforced single-line (no body, no footer).",
  "keywords": [
    "commitlint",
    "commitlint-config",
    "conventional-commits"
  ],
  "homepage": "https://github.com/coldsmirk/canon/tree/main/packages/commitlint-config#readme",
  "bugs": "https://github.com/coldsmirk/canon/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsmirk/canon.git",
    "directory": "packages/commitlint-config"
  },
  "license": "MIT",
  "author": {
    "name": "Venus"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "import-meta-resolve": "^4.2.0"
  },
  "devDependencies": {
    "@commitlint/lint": "^21.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
